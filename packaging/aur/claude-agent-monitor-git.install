post_install() {
    cat <<'MSG'
==> Register the Claude Code hook (updates ~/.claude/settings.json, backs it up first):
      claude-agent-monitor install-hooks
    Then restart your Claude Code sessions so the hooks load.

==> Print the Waybar + Hyprland config snippets:
      claude-agent-monitor setup

==> Remove the hook later with:
      claude-agent-monitor uninstall-hooks
MSG
}

post_upgrade() {
    post_install
}
